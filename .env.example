# ==========================================
# Campus Skill Exchange Platform - Root .env
# ==========================================
# THIS FILE BELONGS IN `server/.env` BEFORE EXECUTION

# --- SERVER CONFIGURATION ---
PORT=5000
NODE_ENV=development

# --- DATABASE ---
# MongoDB Connection String (Local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/campus-skill-exchange

# --- AUTHENTICATION ---
# Secret key used for signing JWT tokens
JWT_SECRET=super_secret_campus_key_2026
JWT_EXPIRE=30d

# --- EMAIL SERVICE (OPTIONAL HACKATHON FEATURE) ---
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_smtp_username
EMAIL_PASS=your_smtp_password
EMAIL_FROM=noreply@campusskills.edu

# --- ARTIFICIAL INTELLIGENCE (OPTIONAL HACKATHON FEATURE) ---
# OpenAI API key to power AI-based skill matching in V2
OPENAI_API_KEY=sk-your-openai-api-key-here
