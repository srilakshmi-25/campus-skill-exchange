# ==========================================
# Campus Skill Exchange Platform - .env
# ==========================================

# --- SERVER CONFIGURATION ---
# Port where the Node.js server will listen
PORT=5000

# Environment mode (development, production, test)
NODE_ENV=development

# --- DATABASE ---
# MongoDB Connection String (Local or MongoDB Atlas)
# Replace `<username>`, `<password>`, and `<cluster>` if using Atlas
MONGO_URI=mongodb://127.0.0.1:27017/campus-skill-exchange

# --- AUTHENTICATION ---
# Secret key used for signing JWT tokens (use a strong random string in production)
JWT_SECRET=super_secret_campus_key_2026
# Expiration time for JWT auth tokens
JWT_EXPIRE=30d

# --- EMAIL SERVICE (OPTIONAL) ---
# Credentials for SMTP email provider (e.g., SendGrid, Mailgun, or standard SMTP) used for Campus domain verification
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_smtp_username
EMAIL_PASS=your_smtp_password
EMAIL_FROM=noreply@campusskills.edu

# --- ARTIFICIAL INTELLIGENCE (OPTIONAL) ---
# OpenAI API key to power AI-based skill matching and advanced course suggestions algorithm
OPENAI_API_KEY=sk-your-openai-api-key-here
